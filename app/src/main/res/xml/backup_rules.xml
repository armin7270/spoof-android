<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup policy for Android 11 and lower (android:fullBackupContent).

  Credentials and routing preferences must not be copied off the device, so the
  only thing excluded here is everything. See data_extraction_rules.xml for the
  Android 12+ equivalent.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
